#!/bin/bash

set -e
set -o pipefail

# Colors for output
GREEN='\033[0;32m'
NC='\033[0m' # No Color

log() {
  echo -e "${GREEN}[INFO]${NC} $1"
}

log "Running setup-remote @1b10541+" # bump this marker with every change

# Install sudo if not present
log "Updating package index..."
if ! command -v sudo &>/dev/null; then
  apt update && apt install -y sudo
fi

log "Installing packages..."
sudo apt update && sudo apt install -y tmux vim git htop nvtop bat iputils-ping iperf fzf

# --- Neovim (editor) ---
log "Installing Neovim + editor dependencies..."
sudo apt install -y build-essential ripgrep fd-find unzip # unzip: Mason needs it (stylua etc.)
mkdir -p $HOME/.local/bin
ln -sf "$(command -v fdfind)" $HOME/.local/bin/fd # Ubuntu ships fd as fdfind
arch=$(dpkg --print-architecture)
if [ "$arch" = "amd64" ]; then arch=x86_64; fi # GitHub release assets use x86_64, not amd64

if [ ! -e $HOME/.local/bin/nvim ]; then
  url=https://github.com/neovim/neovim/releases/latest/download/nvim-linux-$arch.tar.gz
  log "Downloading Neovim: $url"
  curl -fsSL $url | tar xz -C $HOME/.local
  ln -sf $HOME/.local/nvim-linux-$arch/bin/nvim $HOME/.local/bin/nvim
fi

# LazyVim stages/commits through lazygit (<leader>gg)
if [ ! -e $HOME/.local/bin/lazygit ]; then
  tag=$(curl -fsSL https://api.github.com/repos/jesseduffield/lazygit/releases/latest |
    grep -o '"tag_name": *"[^"]*"' | cut -d '"' -f4)
  ver=${tag#v}
  url=https://github.com/jesseduffield/lazygit/releases/download/$tag/lazygit_${ver}_Linux_$arch.tar.gz
  log "Downloading lazygit: $url"
  curl -fsSL $url | tar xz -C $HOME/.local/bin lazygit
fi

if [ ! -d $HOME/dev/dotfiles ]; then
  log "Cloning dotfiles..."
  mkdir -p $HOME/dev
  git clone https://github.com/mikasenghaas/dotfiles.git $HOME/dev/dotfiles
fi

log "Linking Neovim config from dotfiles..."
mkdir -p $HOME/.config
ln -sfn $HOME/dev/dotfiles/.config/nvim $HOME/.config/nvim

# nvim-treesitter builds parsers with the tree-sitter CLI. Mason's prebuilt
# needs glibc >= 2.39 (crashes on Ubuntu 22.04). On older glibc, build it from
# source; LazyVim prefers any tree-sitter already on PATH and skips Mason then.
glibc=$(ldd --version | head -1 | grep -o '[0-9.]*$')
if [ "$(printf '%s\n2.39\n' "$glibc" | sort -V | head -1)" != "2.39" ]; then
  log "glibc $glibc < 2.39: providing source-built tree-sitter-cli"
  if [ ! -e $HOME/.cargo/bin/tree-sitter ]; then
    sudo apt install -y libclang-dev
    if [ ! -e $HOME/.cargo/bin/cargo ]; then
      log "Installing rust (minimal profile)..."
      curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
    fi
    log "Building tree-sitter-cli 0.26.13 from source (takes a few minutes)..."
    $HOME/.cargo/bin/cargo install tree-sitter-cli --version 0.26.13 --locked
  fi
  ln -sf $HOME/.cargo/bin/tree-sitter $HOME/.local/bin/tree-sitter
  # replace a crashing mason copy left by older script runs
  if [ -e $HOME/.local/share/nvim/mason/bin/tree-sitter ] &&
    ! $HOME/.local/share/nvim/mason/bin/tree-sitter --version >/dev/null 2>&1; then
    cp -f $HOME/.cargo/bin/tree-sitter $HOME/.local/share/nvim/mason/packages/tree-sitter-cli/tree-sitter-*
    log "Replaced broken mason tree-sitter-cli with source-built binary"
  fi
fi

log "Bootstrapping Neovim plugins from lazy-lock.json..."
$HOME/.local/bin/nvim --headless "+Lazy! restore" +qa </dev/null || log "Plugins will finish installing on first nvim launch"

# Install 1Password CLI
if ! command -v op &>/dev/null; then
  log "Installing 1password-cli..."
  curl -sS https://downloads.1password.com/linux/keys/1password.asc |
    sudo gpg --dearmor --output /usr/share/keyrings/1password-archive-keyring.gpg &&
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/$(dpkg --print-architecture) stable main" |
    sudo tee /etc/apt/sources.list.d/1password.list &&
    sudo mkdir -p /etc/debsig/policies/AC2D62742012EA22/ &&
    curl -sS https://downloads.1password.com/linux/debian/debsig/1password.pol |
    sudo tee /etc/debsig/policies/AC2D62742012EA22/1password.pol &&
    sudo mkdir -p /usr/share/debsig/keyrings/AC2D62742012EA22 &&
    curl -sS https://downloads.1password.com/linux/keys/1password.asc |
    sudo gpg --dearmor --output /usr/share/debsig/keyrings/AC2D62742012EA22/debsig.gpg &&
    sudo apt update && sudo apt install -y 1password-cli
fi

if ! command -v uv &>/dev/null; then
  log "Installing uv..."
  curl -LsSf https://astral.sh/uv/install.sh | sh
  source $HOME/.local/bin/env
fi

if ! command -v hf &>/dev/null; then
  log "Installing huggingface-hub..."
  uv tool install huggingface-hub[cli]
fi

if ! command -v wandb &>/dev/null; then
  log "Installing wandb..."
  uv tool install wandb
fi

if ! command -v prime &>/dev/null; then
  log "Installing prime..."
  uv tool install prime
fi

if ! command -v gh &>/dev/null; then
  log "Installing gh..."
  sudo apt update && sudo apt install gh -y
fi

if [ ! -e $HOME/.local/bin/claude ]; then
  log "Installing claude..."
  curl -fsSL https://claude.ai/install.sh | bash || log "claude install failed, continuing"
fi

if [ ! -e $HOME/.local/bin/codex ]; then
  log "Installing codex..."
  curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=1 sh || log "codex install failed, continuing"
fi

# --- node via nvm (general npm tooling; prime-agent no longer needs it) ---
if [ ! -d $HOME/.nvm ]; then
  log "Installing nvm..."
  curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.7/install.sh | PROFILE=/dev/null bash || log "nvm install failed, continuing"
fi
if ! grep -q "NVM_DIR" $HOME/.bashrc 2>/dev/null; then
  log "Adding nvm init to .bashrc..."
  printf '\n# Node via nvm\nexport NVM_DIR="$HOME/.nvm"\n[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"\n' >> $HOME/.bashrc
fi
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
if ! command -v node &>/dev/null; then
  log "Installing node LTS..."
  nvm install --lts || log "node install failed, continuing"
fi
# --- prime-agent (official installer; self-contained runtime, no node needed) ---
if [ ! -e $HOME/.local/bin/prime-agent ]; then
  log "Installing prime-agent..."
  curl --proto '=https' --proto-redir '=https' -fsSL https://app.primeintellect.ai/prime-agent/install.sh |
    PRIME_AGENT_INSTALLER_NONINTERACTIVE=1 sh || log "prime-agent install failed, continuing"
fi

log "Installing starship..."
curl -sS https://starship.rs/install.sh | sudo sh -s -- -y

log "Updating .bashrc..."
if grep -q "starship init bash" $HOME/.bashrc 2>/dev/null; then
  log ".bashrc already set up, leaving it untouched"
else
  cat >>$HOME/.bashrc <<'EOL'

# --- setup-remote managed block ---
# Guard
[[ $- != *i* ]] && return

# Aliases
alias ll="ls -lal"
alias cat="bat --style=plain"

# Make bat available on ubuntu
if [ ! -e ~/.local/bin/bat ]; then
    ln -s /usr/bin/batcat ~/.local/bin/bat
fi

# Load fzf key bindings and completion
if command -v fzf >/dev/null 2>&1; then
    if fzf --bash >/dev/null 2>&1; then
        eval "$(fzf --bash)"
    else
        [ -f /usr/share/doc/fzf/examples/key-bindings.bash ] && source /usr/share/doc/fzf/examples/key-bindings.bash
        [ -f /usr/share/bash-completion/completions/fzf ] && source /usr/share/bash-completion/completions/fzf
        [ -f /usr/share/doc/fzf/examples/completion.bash ] && source /usr/share/doc/fzf/examples/completion.bash
    fi
fi

# Add ~/.local/bin to path (for uv)
export PATH="$HOME/.local/bin:$PATH"

# Access 1Password secrets temporarily
export OP_SERVICE_ACCOUNT_TOKEN=

# Initialize starship
eval "$(starship init bash)"
EOL
fi

if [ -f $HOME/.env ]; then
  log "~/.env already exists, leaving it untouched"
else
  log "Creating ~/.env template (fill in API keys)..."
  cat >$HOME/.env <<'EOL'
GH_TOKEN=
HF_TOKEN=
OPENAI_API_KEY=
PRIME_API_KEY=
PRIME_TEAM_ID=
WANDB_API_KEY=
EOL
  chmod 600 $HOME/.env
fi

log "Installation completed! Add API keys to ~/.env, then run \":Copilot auth\" in nvim once to enable Copilot."
